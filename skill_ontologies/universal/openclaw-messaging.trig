@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_openclaw_messaging {
  # Type-level possible routes, not claims that a plugin is installed or enabled.
  ar:MessagingChannelInvocation a ar:InvocationSurfaceKind ;
    rdfs:comment "Abstract invocation through a messaging channel; the exact API may be unknown." .
  ar:OpenClawChannelPlugin a ar:InvocationSurfaceKind ;
    ar:specializesInvocationKind ar:MessagingChannelInvocation ;
    rdfs:comment "Channel plugin selected by OpenClaw for a configured provider; actual installation and authority are runtime questions." ;
    rdfs:seeAlso <https://docs.openclaw.ai/plugins/architecture>, <https://docs.openclaw.ai/cli/message> .
  ar:OpenClawChannelAdapter a ar:InvocationSurfaceKind ;
    ar:specializesInvocationKind ar:OpenClawChannelPlugin ;
    rdfs:comment "Channel-plugin action/outbound adapter behind OpenClaw messaging; provider-specific adapters are narrower kinds." ;
    rdfs:seeAlso <https://docs.openclaw.ai/plugins/architecture>, <https://docs.openclaw.ai/plugins/sdk-channel-plugins> .
  ar:OpenClawMessageTool a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:ToolEndpoint ;
    ar:routesToKind ar:OpenClawChannelAdapter ;
    rdfs:comment "Core-owned agent-facing shared message tool; not the openclaw message CLI." ;
    rdfs:seeAlso <https://docs.openclaw.ai/plugins/architecture> .
  ar:OpenClawMessageCLI a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:ShellCommandExecution ;
    ar:routesToKind ar:OpenClawChannelPlugin ;
    rdfs:comment "Shell-invoked openclaw message command, distinct from the agent-facing message tool." ;
    rdfs:seeAlso <https://docs.openclaw.ai/cli/message> .
}
