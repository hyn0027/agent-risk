@prefix ar: <urn:agent-risk:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ar:EndpointSurfaceOntology a owl:Ontology ;
  rdfs:comment "Lightweight vocabulary for potential invocation surfaces, affected world surfaces, and skill-described operations. Assertions are claims, not verified runtime authority or guaranteed effects." .

ar:Skill a rdfs:Class .
ar:OntologyModule a rdfs:Class ;
  rdfs:comment "A statically discoverable ontology graph and its load dependencies. Declaring a module does not cause dynamic loading." .
ar:SurfaceKind a rdfs:Class .
ar:InvocationSurfaceKind a rdfs:Class ; rdfs:subClassOf ar:SurfaceKind .
ar:ToolEndpointKind a rdfs:Class ; rdfs:subClassOf ar:InvocationSurfaceKind ;
  rdfs:comment "Class of callable tool-endpoint kinds. Membership does not assert that a concrete endpoint is enabled in a runtime." .
ar:WorldSurfaceKind a rdfs:Class ; rdfs:subClassOf ar:SurfaceKind .
ar:SystemComponentKind a rdfs:Class ; rdfs:subClassOf ar:WorldSurfaceKind ;
  rdfs:comment "Architectural component kinds that may hold state, execute logic, or mediate access. Being a component kind does not assert that an instance is running." .
ar:SecurityControlKind a rdfs:Class ; rdfs:subClassOf ar:WorldSurfaceKind ;
  rdfs:comment "Configuration or enforcement mechanism relevant to reachability or authority. A declared control is not evidence that it is enabled or effective at runtime." .
ar:Operation a rdfs:Class .
ar:PotentialEffect a rdfs:Class .
ar:EffectType a rdfs:Class .
ar:Requirement a rdfs:Class .
ar:EvidenceStatus a rdfs:Class .
ar:AdaptationMapping a rdfs:Class ;
  rdfs:comment "Auditable crosswalk from one source-skill assumption or action to its NanoClaw interpretation." .
ar:AdaptationDisposition a rdfs:Class .
ar:AdaptationPolicy a rdfs:Class .

ar:declaresOperation a rdf:Property ; rdfs:domain ar:Skill ; rdfs:range ar:Operation .
ar:ontologyModuleId a rdf:Property ; rdfs:domain ar:OntologyModule ; rdfs:range xsd:string .
ar:requiresOntologyModule a rdf:Property ; rdfs:range xsd:string ;
  rdfs:comment "Static identifier of an ontology module required by a skill or another module. The loader validates this metadata against load-config.json but never loads it dynamically." .
ar:resourcesOnly a rdf:Property ; rdfs:domain ar:OntologyModule ; rdfs:range xsd:boolean .
ar:sourceRepositoryPath a rdf:Property ; rdfs:domain ar:OntologyModule ; rdfs:range xsd:string .
ar:sourceRevision a rdf:Property ; rdfs:domain ar:OntologyModule ; rdfs:range xsd:string .
ar:skillDirectory a rdf:Property ; rdfs:domain ar:Skill ; rdfs:range xsd:string .
ar:sourceSha256 a rdf:Property ; rdfs:domain ar:Skill ; rdfs:range xsd:string .
ar:hasAdaptationMapping a rdf:Property ; rdfs:domain ar:Skill ; rdfs:range ar:AdaptationMapping .
ar:governedByAdaptationPolicy a rdf:Property ; rdfs:domain ar:Skill ; rdfs:range ar:AdaptationPolicy .
ar:sourceAssumption a rdf:Property ; rdfs:domain ar:AdaptationMapping ; rdfs:range xsd:string .
ar:nanoclawModel a rdf:Property ; rdfs:domain ar:AdaptationMapping ; rdfs:range xsd:string .
ar:adaptationDisposition a rdf:Property ; rdfs:domain ar:AdaptationMapping ; rdfs:range ar:AdaptationDisposition .
ar:semanticDifference a rdf:Property ; rdfs:domain ar:AdaptationMapping ; rdfs:range xsd:string .
ar:adaptedOperation a rdf:Property ; rdfs:domain ar:AdaptationMapping ; rdfs:range ar:Operation .
ar:specializesKind a rdf:Property ; rdfs:domain ar:WorldSurfaceKind ; rdfs:range ar:WorldSurfaceKind ;
  rdfs:comment "A narrower resource kind. Multiple parents are allowed. The loader projects this relation into rdfs:subClassOf in its OWL reasoning graph." .
ar:specializesInvocationKind a rdf:Property ;
  rdfs:domain ar:InvocationSurfaceKind ; rdfs:range ar:InvocationSurfaceKind ;
  rdfs:comment "A narrower action channel or execution mechanism. The loader projects it into rdfs:subClassOf in its OWL reasoning graph; it is not a resource containment relation." .
ar:mayBeStoredAsKind a rdf:Property ; rdfs:domain ar:WorldSurfaceKind ; rdfs:range ar:WorldSurfaceKind ;
  rdfs:comment "Possible physical storage representation, not an identity or guaranteed effect." .
ar:sourcePath a rdf:Property ; rdfs:domain ar:Skill ; rdfs:range xsd:string .
ar:sourceStatus a rdf:Property ; rdfs:range ar:EvidenceStatus .
ar:adaptationStatus a rdf:Property ; rdfs:domain ar:Operation ; rdfs:range ar:EvidenceStatus ;
  rdfs:comment "Evidence status for an environment-specific translation, kept separate from the source evidence for the operation." .
ar:sourceNote a rdf:Property ; rdfs:range xsd:string .
ar:invokedThroughKind a rdf:Property ; rdfs:domain ar:Operation ; rdfs:range ar:InvocationSurfaceKind .
ar:routesToKind a rdf:Property ; rdfs:range ar:SurfaceKind .
ar:protectedByKind a rdf:Property ; rdfs:domain ar:SurfaceKind ; rdfs:range ar:SecurityControlKind ;
  rdfs:comment "A type-level protection or policy relationship. Runtime configuration and enforcement must be observed separately." .
ar:sharesKind a rdf:Property ; rdfs:domain ar:WorldSurfaceKind ; rdfs:range ar:WorldSurfaceKind ;
  rdfs:comment "Possible shared state or resource scope. This is neither subtype nor containment and does not imply universal visibility." .
ar:targetsKind a rdf:Property ; rdfs:domain ar:Operation ; rdfs:range ar:WorldSurfaceKind .
ar:requires a rdf:Property ; rdfs:domain ar:Operation ; rdfs:range ar:Requirement .
ar:hasPotentialEffect a rdf:Property ; rdfs:domain ar:Operation ; rdfs:range ar:PotentialEffect .
ar:effectType a rdf:Property ; rdfs:domain ar:PotentialEffect ; rdfs:range ar:EffectType .
ar:affectsKind a rdf:Property ; rdfs:domain ar:PotentialEffect ; rdfs:range ar:WorldSurfaceKind .
ar:conditionalOn a rdf:Property ; rdfs:domain ar:PotentialEffect ; rdfs:range ar:Requirement .
ar:mayEnable a rdf:Property ; rdfs:domain ar:Operation ; rdfs:range ar:Operation .
ar:containsKind a rdf:Property ; rdfs:domain ar:WorldSurfaceKind ; rdfs:range ar:WorldSurfaceKind .
ar:concreteExampleOnly a rdf:Property ; rdfs:range xsd:boolean .

ar:SkillText a ar:EvidenceStatus ; rdfs:label "asserted by skill text" .
ar:ScriptInspected a ar:EvidenceStatus ; rdfs:label "supported by inspected bundled script" .
ar:ExampleOnly a ar:EvidenceStatus ; rdfs:label "illustrative example; not verified deployment" .
ar:RuntimeUnverified a ar:EvidenceStatus ; rdfs:label "runtime presence and authority unverified" .
ar:InferredForNanoClaw a ar:EvidenceStatus ;
  rdfs:label "conservative NanoClaw adaptation; not asserted by the source skill" ;
  rdfs:comment "The operation or route is a reviewed translation into the inspected NanoClaw architecture. It must not be read as a claim about the original skill or a deployed installation." .

ar:NativeAdaptation a ar:AdaptationDisposition ;
  rdfs:label "native" ;
  rdfs:comment "An inspected NanoClaw endpoint has the relevant contract. Native classification still does not prove that the endpoint is deployed or authorized." .
ar:ConditionalAdaptation a ar:AdaptationDisposition ;
  rdfs:label "conditional" ;
  rdfs:comment "Behavior depends on provider tools, installed adapters, mounts, credentials, configuration, or policy." .
ar:ApproximateAdaptation a ar:AdaptationDisposition ;
  rdfs:label "approximation" ;
  rdfs:comment "NanoClaw lacks the same abstraction, so the translated workflow has materially different semantics." .
ar:UnsupportedAdaptation a ar:AdaptationDisposition ;
  rdfs:label "unsupported or omitted" ;
  rdfs:comment "No matching built-in NanoClaw endpoint was found; the operation is omitted unless an additional endpoint is introduced." .

ar:NanoClawSkillAdaptationPolicy a ar:AdaptationPolicy ;
  rdfs:label "NanoClaw skill-ontology adaptation policy" ;
  rdfs:comment "Records where source skills differ from their ontology translation. It is an audit model, not executable skill text. Source skills span several environments and some explicitly assume OpenClaw; mappings describe plausible execution in NanoClaw revision 7902716b5b930215dbee4f56b8fb5b938d40468d." ;
  ar:sourceNote "Every adapted operation uses ar:adaptationStatus ar:InferredForNanoClaw while ar:sourceStatus independently records skill-text, inspected-script, or example evidence. Effects are conservative possibilities, not proof of deployment, permission, successful execution, or behavioral equivalence. An absent exact endpoint must be omitted or represented as an explicit approximation with its requirements; the model must not silently widen NanoClaw's interface." .

ar:Read a ar:EffectType ; rdfs:comment "Access or obtain information; does not assert world-state mutation." .
ar:Create a ar:EffectType .
ar:Update a ar:EffectType .
ar:Delete a ar:EffectType .
ar:Transmit a ar:EffectType ; rdfs:comment "Data sent to another surface, without asserting a human read it." .
ar:Execute a ar:EffectType .
ar:Configure a ar:EffectType .
ar:Authenticate a ar:EffectType .
ar:Install a ar:EffectType .
ar:Delegate a ar:EffectType .
ar:Validate a ar:EffectType .
ar:Notify a ar:EffectType .

# Cross-skill kinds are types, not claims that the harness exposes them.
ar:SubagentSpawnTool a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
  ar:specializesInvocationKind ar:ToolEndpoint .
ar:ProcessControlTool a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
  ar:specializesInvocationKind ar:ToolEndpoint .
ar:ProcessEnvironment a ar:WorldSurfaceKind .
ar:ExternalService a ar:WorldSurfaceKind .
ar:Credential a ar:WorldSurfaceKind .
ar:HumanRecipient a ar:WorldSurfaceKind ;
  rdfs:comment "Potential downstream recipient; a send operation does not prove attention or behavior." .
