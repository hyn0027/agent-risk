@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_1password {
  ar:skill_1password a ar:Skill ;
    ar:sourcePath "/Users/yhong3/Documents/Research/agent-risk/top_skills/1password-1.0.0/SKILL.md" ;
    ar:declaresOperation ar:op_op_signin, ar:op_op_inspect, ar:op_op_read,
      ar:op_op_read_file, ar:op_op_run, ar:op_op_inject, ar:op_browser_signin .

  ar:OnePasswordCLI a ar:InvocationSurfaceKind ; ar:routesToKind ar:OnePasswordAccount .
  ar:BrowserCredentialFlow a ar:InvocationSurfaceKind ; ar:routesToKind ar:WebsiteAccount .
  ar:OnePasswordAccount a ar:WorldSurfaceKind .
  ar:OnePasswordVault a ar:WorldSurfaceKind .
  ar:VaultItem a ar:WorldSurfaceKind .
  ar:WebsiteAccount a ar:WorldSurfaceKind .
  ar:OnePasswordAccount ar:containsKind ar:OnePasswordVault .
  ar:OnePasswordVault ar:containsKind ar:VaultItem .
  ar:AuthenticatedSession a ar:WorldSurfaceKind .
  ar:SecretValue a ar:WorldSurfaceKind .
  ar:LocalSecretFile a ar:WorldSurfaceKind .

  ar:cond_op_installed a ar:Requirement .
  ar:cond_auth_available a ar:Requirement .
  ar:cond_vault_access a ar:Requirement .
  ar:cond_browser_credential_tools a ar:Requirement .
  ar:cond_website_login a ar:Requirement .
  ar:cond_auth_available rdfs:comment "Service-account token, desktop app integration, or standalone sign-in; actual mode unverified." .

  ar:op_op_signin a ar:Operation ; ar:invokedThroughKind ar:OnePasswordCLI ;
    ar:targetsKind ar:OnePasswordAccount ; ar:requires ar:cond_op_installed ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Authenticate ; ar:affectsKind ar:AuthenticatedSession ] .

  ar:op_op_inspect a ar:Operation ; ar:invokedThroughKind ar:OnePasswordCLI ;
    ar:targetsKind ar:OnePasswordAccount, ar:OnePasswordVault ; ar:requires ar:cond_auth_available ;
    ar:sourceNote "op whoami, account list, and vault list inspect metadata, not secret contents." ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:OnePasswordAccount, ar:OnePasswordVault ] .

  ar:op_op_read a ar:Operation ; ar:invokedThroughKind ar:OnePasswordCLI ;
    ar:targetsKind ar:VaultItem ; ar:requires ar:cond_auth_available, ar:cond_vault_access ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:VaultItem ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:ProcessEnvironment ] .

  ar:op_op_read_file a ar:Operation ; ar:invokedThroughKind ar:OnePasswordCLI ;
    ar:targetsKind ar:VaultItem, ar:LocalSecretFile ; ar:requires ar:cond_auth_available, ar:cond_vault_access ;
    ar:sourceNote "The bundled CLI examples include op read --out-file; this can persist a secret." ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:VaultItem ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:LocalSecretFile ] .

  ar:op_op_run a ar:Operation ; ar:invokedThroughKind ar:OnePasswordCLI ;
    ar:targetsKind ar:VaultItem, ar:ProcessEnvironment ; ar:requires ar:cond_auth_available, ar:cond_vault_access ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:VaultItem ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:ProcessEnvironment ] .

  ar:op_op_inject a ar:Operation ; ar:invokedThroughKind ar:OnePasswordCLI ;
    ar:targetsKind ar:VaultItem, ar:LocalFile ; ar:requires ar:cond_auth_available, ar:cond_vault_access ;
    ar:sourceNote "May output injected text to stdout or, with -o, write a local config file." ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:VaultItem ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:LocalFile ] .

  ar:op_browser_signin a ar:Operation ; ar:invokedThroughKind ar:BrowserCredentialFlow ;
    ar:targetsKind ar:WebsiteAccount ; ar:requires ar:cond_browser_credential_tools, ar:cond_website_login ;
    ar:sourceNote "Conditional browser sign-in branch; website and browser tools are not specified or verified." ;
    ar:sourceStatus ar:SkillText ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Authenticate ; ar:affectsKind ar:WebsiteAccount ] .
}
