@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_agent_browser {
  ar:skill_agent_browser a ar:Skill ;
    ar:skillDirectory "agent-browser" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/nanoclaw/container/skills/agent-browser/SKILL.md" ;
    ar:sourceSha256 "8b7674ba959591c632520f8a9c8a4332ccf67670d25528c444200efad856e039" ;
    ar:requiresOntologyModule "container-tooling", "nanoclaw-runtime", "nanoclaw-network",
      "freeform-internet", "shell-execution", "local-filesystem" ;
    ar:subjectToControlKind ar:NanoClawEgressLockdownControl, ar:OneCLIGatewayPolicy,
      ar:NanoClawContainerIsolationControl, ar:NanoClawMountModeControl,
      ar:NanoClawProviderToolPolicyControl, ar:RemoteServiceAuthorizationControl ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_agent_browser_native, ar:adapt_agent_browser_egress,
      ar:adapt_agent_browser_saved_state, ar:adapt_agent_browser_example_credentials ;
    ar:sourceNote "NanoClaw container skill (container/skills/agent-browser). Drives a headless Chromium through the agent-browser CLI via the shell (allowed-tools: Bash(agent-browser:*)). Loaded into every session whose skill selection includes it." ;
    ar:declaresOperation ar:op_browser_open_read, ar:op_browser_interact, ar:op_browser_login,
      ar:op_browser_upload, ar:op_browser_capture, ar:op_browser_state, ar:op_browser_cookies,
      ar:op_browser_eval .

  ar:cond_site_credentials_known a ar:Requirement ;
    rdfs:comment "The agent has a username/password (or similar) for the site, e.g. supplied in chat or found in a file." .

  ar:op_browser_open_read a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserPage ;
    ar:requires ar:cond_agent_browser_available, ar:cond_browser_proxy_honored, ar:cond_network_route_permitted ;
    ar:mayInitiateInternetCall ar:call_browser_page_load ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "open/back/forward/reload, snapshot, get text|html|value|attr|title|url|count, wait. Reads the rendered page (including client-side content) into the agent's context." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:BrowserPage ],
      [ a ar:PotentialEffect ; ar:effectType ar:Execute ; ar:affectsKind ar:AgentBrowserSession ] .

  ar:op_browser_interact a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserPage, ar:BrowserRemoteAppState ;
    ar:requires ar:cond_agent_browser_available, ar:cond_browser_proxy_honored, ar:cond_network_route_permitted ;
    ar:mayInitiateInternetCall ar:call_browser_interact ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "click, dblclick, fill, type, press, check, select, scroll, find ... click/fill. Submitting a form or pressing a button can change server-side state on any reachable site (the skill's form-submission example does exactly this)." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:BrowserRemoteAppState ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:BrowserRemoteAppState ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:BrowserRemoteAppState ] .

  ar:op_browser_login a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserSiteAccount ;
    ar:requires ar:cond_agent_browser_available, ar:cond_browser_proxy_honored, ar:cond_network_route_permitted,
      ar:cond_site_credentials_known ;
    ar:mayInitiateInternetCall ar:call_browser_login ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "The skill's 'Authentication with saved state' flow fills a username and password into a login form. The password passes through the agent's context and command line; OneCLI does not inject form credentials." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Authenticate ; ar:affectsKind ar:BrowserSiteAccount ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:BrowserSiteAccount ] .

  ar:op_browser_upload a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:NanoClawContainerFile, ar:BrowserRemoteAppState ;
    ar:requires ar:cond_agent_browser_available, ar:cond_container_file_readable, ar:cond_network_route_permitted ;
    ar:mayInitiateInternetCall ar:call_browser_upload ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "upload @ref file: sends a container-visible file to the site through a file input." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:NanoClawContainerFile ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:BrowserRemoteAppState ] .

  ar:op_browser_capture a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserCapture ;
    ar:requires ar:cond_agent_browser_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "screenshot [path] [--full] and pdf <path> write files to a temp directory or the given path." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:BrowserPage ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:BrowserCapture ] .

  ar:op_browser_state a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserAuthStateFile, ar:BrowserCookieJar ;
    ar:requires ar:cond_agent_browser_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "state save auth.json / state load auth.json persist and restore a logged-in session as a file. Written under /workspace/agent it survives across sessions of the group." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:BrowserAuthStateFile ],
      [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:BrowserAuthStateFile ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:BrowserCookieJar ] .

  ar:op_browser_cookies a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserCookieJar ;
    ar:requires ar:cond_agent_browser_available ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "cookies / cookies set / cookies clear / storage local [set]: read and change session cookies and storage, including session tokens." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:BrowserCookieJar ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:BrowserCookieJar ],
      [ a ar:PotentialEffect ; ar:effectType ar:Delete ; ar:affectsKind ar:BrowserCookieJar ] .

  ar:op_browser_eval a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:BrowserPage ;
    ar:requires ar:cond_agent_browser_available ;
    ar:mayInitiateInternetCall ar:call_browser_eval ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "eval runs arbitrary JavaScript in the page's origin: it can read the DOM and storage and issue requests with the page's cookies." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Execute ; ar:affectsKind ar:BrowserPage ],
      [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:BrowserCookieJar ] .

  ar:call_browser_page_load a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:AgentBrowserCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:UnspecifiedPublicInternetEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callConditionalOn ar:cond_browser_proxy_honored ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Any URL the agent opens, plus every subresource the page loads (scripts, images, XHR). One command can cause many requests to many hosts." .

  ar:call_browser_interact a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:AgentBrowserCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:UnspecifiedPublicInternetEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callConditionalOn ar:cond_browser_proxy_honored ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Form submissions and clicks send requests (often POST) to the page's site and whatever it calls." .

  ar:call_browser_login a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:AgentBrowserCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:UnspecifiedPublicInternetEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callConditionalOn ar:cond_browser_proxy_honored ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "The login form posts the typed credentials to the site." .

  ar:call_browser_upload a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:AgentBrowserCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:UnspecifiedPublicInternetEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callConditionalOn ar:cond_browser_proxy_honored ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "The selected file is uploaded to the site." .

  ar:call_browser_eval a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:AgentBrowserCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:UnspecifiedPublicInternetEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callConditionalOn ar:cond_browser_proxy_honored ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Script run with eval can issue requests with the page's cookies to its origin or elsewhere." .

  ar:adapt_agent_browser_native a ar:AdaptationMapping ;
    ar:sourceAssumption "An agent-browser CLI with a Chromium browser is on PATH." ;
    ar:nanoclawModel "Baked into the NanoClaw agent image (AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium); invoked through the container shell." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "None: this is a NanoClaw-shipped container skill." ;
    ar:adaptedOperation ar:op_browser_open_read .
  ar:adapt_agent_browser_egress a ar:AdaptationMapping ;
    ar:sourceAssumption "The browser can reach any site." ;
    ar:nanoclawModel "Traffic leaves through the OneCLI gateway when Chromium honors the proxy; under egress lockdown nothing else is reachable." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "Reachability, credential injection, and block rules come from the gateway; a site's own login is separate from OneCLI credentials." ;
    ar:adaptedOperation ar:op_browser_interact .
  ar:adapt_agent_browser_saved_state a ar:AdaptationMapping ;
    ar:sourceAssumption "Saved auth state is a convenience file." ;
    ar:nanoclawModel "A plain JSON file of live cookies in the session or group workspace (both bind-mounted from the host)." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "Saved under /workspace/agent it persists on the host and is readable by every session of the agent group." ;
    ar:adaptedOperation ar:op_browser_state .
  ar:adapt_agent_browser_example_credentials a ar:AdaptationMapping ;
    ar:sourceAssumption "Examples fill literal passwords (\"password123\")." ;
    ar:nanoclawModel "Login is modeled as a conditional operation requiring known site credentials." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "NanoClaw's onecli-gateway skill tells the agent never to ask for credentials, so browser logins depend on credentials obtained some other way." ;
    ar:adaptedOperation ar:op_browser_login .
}
