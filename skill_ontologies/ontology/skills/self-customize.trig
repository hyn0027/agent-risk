@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_self_customize {
  ar:skill_self_customize a ar:Skill ;
    ar:skillDirectory "self-customize" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/nanoclaw/container/skills/self-customize/SKILL.md" ;
    ar:sourceSha256 "338d69ed6a1f618bd99f7491a82760052bd45153b94e1eb5e81b1dd86be5e815" ;
    ar:requiresOntologyModule "container-tooling", "nanoclaw-core", "nanoclaw-runtime",
      "nanoclaw-control", "nanoclaw-messaging", "nanoclaw-network", "local-filesystem" ;
    ar:subjectToControlKind ar:NanoClawHumanApprovalControl, ar:NanoClawHostActionGuard,
      ar:NanoClawCLIScopeControl, ar:NanoClawMountModeControl, ar:NanoClawDestinationACL,
      ar:NanoClawAgentMessageGuard, ar:OneCLIGatewayPolicy ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_selfcust_instructions, ar:adapt_selfcust_packages,
      ar:adapt_selfcust_mcp, ar:adapt_selfcust_builder, ar:adapt_selfcust_send_to_agent,
      ar:adapt_selfcust_builder_source_edit ;
    ar:sourceNote "NanoClaw container skill (container/skills/self-customize). Decision tree for changing the agent itself: memory and standing instructions (no approval), install_packages and add_mcp_server (admin approval), and source changes delegated to a builder agent made with create_agent." ;
    ar:declaresOperation ar:op_selfcust_edit_instructions, ar:op_selfcust_install_packages,
      ar:op_selfcust_add_mcp_server, ar:op_selfcust_create_builder, ar:op_selfcust_delegate,
      ar:op_selfcust_prototype_install, ar:op_selfcust_builder_edit_source .

  ar:cond_selfmod_admin_approved a ar:Requirement ;
    rdfs:comment "An admin (scoped, global, or owner) approves the held self-modification request." .
  ar:cond_create_agent_permitted a ar:Requirement ;
    rdfs:comment "create_agent is allowed outright under global cli_scope, otherwise held until an admin approves it." .

  ar:op_selfcust_edit_instructions a ar:Operation ; ar:invokedThroughKind ar:NanoClawProviderFileTool ;
    ar:targetsKind ar:NanoClawPersistentMemory, ar:NanoClawInstructionSource ;
    ar:requires ar:cond_provider_file_tool_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Edit memory/ or instructions.prepend.md directly, no approval. Both are in the group workspace on the host; instructions.prepend.md is composed into the provider document at every spawn, so the change steers every later session of the group." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:NanoClawPersistentMemory ],
      [ a ar:PotentialEffect ; ar:effectType ar:Configure ; ar:affectsKind ar:NanoClawInstructionSource ] .

  ar:op_selfcust_install_packages a ar:Operation ; ar:invokedThroughKind ar:NanoClawInstallPackagesTool ;
    ar:targetsKind ar:NanoClawContainerConfiguration, ar:NanoClawAgentImage ;
    ar:requires ar:cond_builtin_messaging_tool_available, ar:cond_selfmod_admin_approved ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "install_packages({apt, npm, reason}); on approval the host rebuilds the group's image and restarts its containers." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Install ; ar:affectsKind ar:NanoClawAgentImage ],
      [ a ar:PotentialEffect ; ar:effectType ar:Configure ; ar:affectsKind ar:NanoClawContainerConfiguration ] .

  ar:op_selfcust_add_mcp_server a ar:Operation ; ar:invokedThroughKind ar:NanoClawAddMCPServerTool ;
    ar:targetsKind ar:NanoClawContainerConfiguration ;
    ar:requires ar:cond_builtin_messaging_tool_available, ar:cond_selfmod_admin_approved ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "add_mcp_server({name, command, args}), e.g. an npx server found on mcp.so; on approval the container restarts with it. The server's code then runs in the container and its tools join the agent's toolset." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Configure ; ar:affectsKind ar:NanoClawContainerConfiguration ],
      [ a ar:PotentialEffect ; ar:effectType ar:Install ; ar:affectsKind ar:NanoClawContainerProcess ] .

  ar:op_selfcust_create_builder a ar:Operation ; ar:invokedThroughKind ar:NanoClawCreateAgentTool ;
    ar:targetsKind ar:NanoClawAgentGroup, ar:NanoClawDestinationGrant ;
    ar:requires ar:cond_builtin_messaging_tool_available, ar:cond_create_agent_permitted ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "create_agent({name: 'Builder', instructions}) creates a persistent agent group with its own workspace and a two-way destination pair." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:NanoClawAgentGroup ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:NanoClawDestinationGrant ] .

  ar:op_selfcust_delegate a ar:Operation ; ar:invokedThroughKind ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:NanoClawProjectedDestination ;
    ar:requires ar:cond_builtin_messaging_tool_available, ar:cond_destination_projected_and_authorized ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "The skill says send_to_agent; NanoClaw has no such tool, so delegation is send_message to the builder's agent destination." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Delegate ; ar:affectsKind ar:NanoClawAgentGroup ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:NanoClawInboundMessage ] .

  ar:op_selfcust_prototype_install a ar:Operation ; ar:invokedThroughKind ar:PackageManagerCLI ;
    ar:targetsKind ar:InstalledPackageTree ;
    ar:requires ar:cond_container_shell_available, ar:cond_container_file_writable, ar:cond_package_registry_reachable ;
    ar:mayInitiateInternetCall ar:call_selfcust_registry ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Prototype first with pnpm install in /workspace/agent/ — no approval, and the packages persist in the group workspace on the host." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Install ; ar:affectsKind ar:InstalledPackageTree ],
      [ a ar:PotentialEffect ; ar:effectType ar:Execute ; ar:affectsKind ar:NanoClawContainerProcess ] .

  ar:op_selfcust_builder_edit_source a ar:Operation ; ar:invokedThroughKind ar:NanoClawProviderFileTool ;
    ar:targetsKind ar:NanoClawSharedRunnerSource ;
    ar:requires ar:cond_provider_file_tool_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "The builder is told to edit container/agent-runner/src and the Dockerfile. In NanoClaw /app/src is a read-only mount and the project root is not mounted, so the edit fails unless an operator adds a writable mount of the source." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:NanoClawSharedRunnerSource ] .

  ar:call_selfcust_registry a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:PackageManagerCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:PackageRegistryEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callEndpointPattern "https://registry.npmjs.org/{package}" ;
    ar:sourceStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Workspace-local installs fetch packages from the registry and run their install scripts in the container." .

  ar:adapt_selfcust_instructions a ar:AdaptationMapping ;
    ar:sourceAssumption "Memory and standing instructions are edited directly, without approval." ;
    ar:nanoclawModel "Files in the read-write group workspace; the host composes instructions.prepend.md into CLAUDE.md at spawn." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "An unapproved, persistent change to the agent's own instructions that reaches every session of the group." ;
    ar:adaptedOperation ar:op_selfcust_edit_instructions .
  ar:adapt_selfcust_packages a ar:AdaptationMapping ;
    ar:sourceAssumption "install_packages requires admin approval." ;
    ar:nanoclawModel "Held by the host guard; approval rebuilds the image on the host." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "None." ;
    ar:adaptedOperation ar:op_selfcust_install_packages .
  ar:adapt_selfcust_mcp a ar:AdaptationMapping ;
    ar:sourceAssumption "add_mcp_server requires admin approval." ;
    ar:nanoclawModel "Held by the host guard; approval writes the container configuration and restarts the container." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "Approval covers wiring the server, not each later tool call it makes." ;
    ar:adaptedOperation ar:op_selfcust_add_mcp_server .
  ar:adapt_selfcust_builder a ar:AdaptationMapping ;
    ar:sourceAssumption "create_agent returns a builder the agent can use immediately." ;
    ar:nanoclawModel "create_agent is held for approval unless the group has global cli_scope." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "With global scope a new agent group and destination pair are created without any human approval." ;
    ar:adaptedOperation ar:op_selfcust_create_builder .
  ar:adapt_selfcust_send_to_agent a ar:AdaptationMapping ;
    ar:sourceAssumption "A send_to_agent tool delivers text to another agent group." ;
    ar:nanoclawModel "send_message to an agent destination, routed by the host with destination and agent-message checks." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "The named tool does not exist; the agent must map it to send_message." ;
    ar:adaptedOperation ar:op_selfcust_delegate .
  ar:adapt_selfcust_builder_source_edit a ar:AdaptationMapping ;
    ar:sourceAssumption "A builder agent can edit the agent-runner source and Dockerfile; edits in /app/src load on next start." ;
    ar:nanoclawModel "/app/src is a shared read-only mount; the Dockerfile and host source are not mounted." ;
    ar:adaptationDisposition ar:UnsupportedAdaptation ;
    ar:semanticDifference "Without an operator-added writable mount the builder cannot change source. With one, the edit would affect every agent group sharing the runner." ;
    ar:adaptedOperation ar:op_selfcust_builder_edit_source .
}
