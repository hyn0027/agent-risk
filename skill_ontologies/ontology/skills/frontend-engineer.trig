@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_frontend_engineer {
  ar:skill_frontend_engineer a ar:Skill ;
    ar:skillDirectory "frontend-engineer" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/nanoclaw/container/skills/frontend-engineer/SKILL.md" ;
    ar:sourceSha256 "c2cd336aa1c63e9f1a918d192cfe0230dd0ade680856ec3633cf98ebe52049c9" ;
    ar:requiresOntologyModule "container-tooling", "nanoclaw-runtime", "nanoclaw-network",
      "nanoclaw-messaging", "freeform-internet", "shell-execution", "local-filesystem" ;
    ar:subjectToControlKind ar:NanoClawEgressLockdownControl, ar:OneCLIGatewayPolicy,
      ar:NanoClawContainerIsolationControl, ar:NanoClawMountModeControl,
      ar:NanoClawResourceLimitControl, ar:NanoClawProviderToolPolicyControl,
      ar:NanoClawDestinationACL, ar:RemoteServiceAuthorizationControl ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_frontend_build_local, ar:adapt_frontend_dev_server,
      ar:adapt_frontend_vercel_deploy, ar:adapt_frontend_report ;
    ar:sourceNote "NanoClaw container skill (container/skills/frontend-engineer). A build-test-verify workflow: write code, install and build, run a dev server, verify with agent-browser, deploy with the Vercel CLI, verify production, report with screenshots." ;
    ar:declaresOperation ar:op_frontend_edit_code, ar:op_frontend_install, ar:op_frontend_build,
      ar:op_frontend_dev_server, ar:op_frontend_verify_local, ar:op_frontend_deploy,
      ar:op_frontend_verify_production, ar:op_frontend_report .

  ar:FrontendProject a ar:WorldSurfaceKind ;
    ar:specializesKind ar:LocalDirectory ;
    rdfs:comment "Source tree of a web project the agent creates or edits." .
  ar:FrontendBuildOutput a ar:WorldSurfaceKind ;
    ar:specializesKind ar:LocalDirectory ;
    rdfs:comment "Build artifacts (e.g. .next/, dist/)." .
  ar:FrontendDevServer a ar:WorldSurfaceKind ;
    ar:specializesKind ar:NanoClawContainerProcess ;
    rdfs:comment "A dev server listening on localhost inside the container (e.g. :3000); not exposed outside the container." .
  ar:VercelCLI a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:ShellCommandExecution ;
    ar:executesOn ar:NanoClawAgentContainer ;
    ar:routesToKind ar:NanoClawProxyAwareHTTPRequest, ar:NanoClawDirectNetworkRequest ;
    rdfs:comment "The vercel CLI, installed only by NanoClaw's /add-vercel skill; its token is the placeholder 'placeholder', replaced by OneCLI for api.vercel.com." .
  ar:VercelDeployment a ar:WorldSurfaceKind ;
    ar:specializesKind ar:RemoteWebResource ;
    rdfs:comment "A deployment of the project on Vercel, published at a public URL (--prod)." .
  ar:VercelAPIEndpoint a ar:WorldSurfaceKind, ar:PublicInternetEndpointKind ;
    ar:specializesKind ar:PublicInternetEndpoint ;
    rdfs:comment "Vercel's deployment API." .
  ar:FrontendProject ar:mayResideInKind ar:NanoClawSessionWorkspace, ar:NanoClawAgentGroupWorkspace, ar:NanoClawContainerLayer .
  ar:FrontendBuildOutput ar:mayResideInKind ar:NanoClawSessionWorkspace, ar:NanoClawAgentGroupWorkspace, ar:NanoClawContainerLayer .
  ar:FrontendProject ar:containsKind ar:FrontendBuildOutput, ar:InstalledPackageTree .
  ar:VercelDeployment ar:protectedByKind ar:RemoteServiceAuthorizationControl .

  ar:cond_vercel_cli_installed a ar:Requirement ;
    rdfs:comment "The vercel CLI is in the agent image, i.e. /add-vercel was applied (not in the stock image)." .
  ar:cond_vercel_credential a ar:Requirement ;
    rdfs:comment "OneCLI holds a Vercel token for api.vercel.com that applies to this agent." .

  ar:op_frontend_edit_code a ar:Operation ; ar:invokedThroughKind ar:NanoClawProviderFileTool ;
    ar:targetsKind ar:FrontendProject ;
    ar:requires ar:cond_provider_file_tool_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Read package.json and existing components, then create or edit source files." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:FrontendProject ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:FrontendProject ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:FrontendProject ] .

  ar:op_frontend_install a ar:Operation ; ar:invokedThroughKind ar:PackageManagerCLI ;
    ar:targetsKind ar:InstalledPackageTree ;
    ar:requires ar:cond_container_shell_available, ar:cond_container_file_writable, ar:cond_package_registry_reachable ;
    ar:mayInitiateInternetCall ar:call_frontend_registry ;
    ar:sourceStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Implied by 'pick the right tool (Next.js, Vite)' and 'pnpm run build': dependencies are installed into the project, running third-party install scripts in the container." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Install ; ar:affectsKind ar:InstalledPackageTree ],
      [ a ar:PotentialEffect ; ar:effectType ar:Execute ; ar:affectsKind ar:NanoClawContainerProcess ] .

  ar:op_frontend_build a ar:Operation ; ar:invokedThroughKind ar:PackageManagerCLI ;
    ar:targetsKind ar:FrontendBuildOutput ;
    ar:requires ar:cond_container_shell_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "pnpm run build; fix all errors before deploying." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Execute ; ar:affectsKind ar:NanoClawContainerProcess ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:FrontendBuildOutput ] .

  ar:op_frontend_dev_server a ar:Operation ; ar:invokedThroughKind ar:PackageManagerCLI ;
    ar:targetsKind ar:FrontendDevServer ;
    ar:requires ar:cond_container_shell_available ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "pnpm run dev & — a background server process inside the container." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Execute ; ar:affectsKind ar:FrontendDevServer ] .

  ar:op_frontend_verify_local a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:FrontendDevServer, ar:BrowserCapture ;
    ar:requires ar:cond_agent_browser_available, ar:cond_container_file_writable ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "agent-browser open http://localhost:3000, screenshots at desktop/tablet sizes, console-error check via eval. Stays inside the container." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:FrontendDevServer ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:BrowserCapture ] .

  ar:op_frontend_deploy a ar:Operation ; ar:invokedThroughKind ar:VercelCLI ;
    ar:targetsKind ar:VercelDeployment ;
    ar:requires ar:cond_vercel_cli_installed, ar:cond_vercel_credential, ar:cond_container_shell_available ;
    ar:mayInitiateInternetCall ar:call_frontend_vercel_deploy ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "vercel deploy --yes --prod --token placeholder: uploads the project and publishes it publicly, with no confirmation step." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:FrontendProject ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:VercelDeployment ] .

  ar:op_frontend_verify_production a ar:Operation ; ar:invokedThroughKind ar:AgentBrowserCLI ;
    ar:targetsKind ar:VercelDeployment ;
    ar:requires ar:cond_agent_browser_available, ar:cond_browser_proxy_honored, ar:cond_network_route_permitted ;
    ar:mayInitiateInternetCall ar:call_frontend_production_load ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "agent-browser open <deployed-url> and screenshot." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:VercelDeployment ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:BrowserCapture ] .

  ar:op_frontend_report a ar:Operation ; ar:invokedThroughKind ar:NanoClawSendFileTool, ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:BrowserCapture ;
    ar:requires ar:cond_builtin_messaging_tool_available, ar:cond_destination_projected_and_authorized ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Report with the live URL and screenshots; in NanoClaw the screenshots go out through send_file." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:BrowserCapture ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:NanoClawOutboundMessage ] .

  ar:call_frontend_registry a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:PackageManagerCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:PackageRegistryEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callEndpointPattern "https://registry.npmjs.org/{package}" ;
    ar:sourceStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Dependency installs fetch package metadata and tarballs; install scripts may make further requests." .
  ar:call_frontend_vercel_deploy a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:VercelCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:VercelAPIEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callEndpointPattern "https://api.vercel.com/" ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "The CLI uploads files and creates the deployment; the gateway swaps the placeholder token for the stored Vercel credential." .

  ar:call_frontend_production_load a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawAgentContainer ;
    ar:callViaKind ar:AgentBrowserCLI, ar:NanoClawProxyAwareHTTPRequest ;
    ar:callEndpointKind ar:UnspecifiedPublicInternetEndpoint ; ar:callStage ar:ContainerEgress ;
    ar:callConditionalOn ar:cond_browser_proxy_honored ;
    ar:sourceStatus ar:SkillText ;
    ar:sourceNote "Loading the deployed site at its public Vercel URL." .

  ar:adapt_frontend_build_local a ar:AdaptationMapping ;
    ar:sourceAssumption "Projects are built and installed locally with pnpm." ;
    ar:nanoclawModel "Package manager runs in the container shell; files live in a writable workspace or the container layer." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "Installs need the npm registry to be reachable through the gateway; with lockdown on, nothing else is." ;
    ar:adaptedOperation ar:op_frontend_install .
  ar:adapt_frontend_dev_server a ar:AdaptationMapping ;
    ar:sourceAssumption "A dev server at localhost:3000 is checked in a real browser." ;
    ar:nanoclawModel "Dev server and agent-browser both run inside the same container." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "The server is not reachable from the host or the user; only the in-container browser sees it." ;
    ar:adaptedOperation ar:op_frontend_verify_local .
  ar:adapt_frontend_vercel_deploy a ar:AdaptationMapping ;
    ar:sourceAssumption "vercel deploy is available with a token." ;
    ar:nanoclawModel "Only after /add-vercel installs the CLI; the token comes from OneCLI via the 'placeholder' convention." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "The stock image has no vercel CLI, so deployment is unavailable until the operator adds it; once added, production deploys need no further approval." ;
    ar:adaptedOperation ar:op_frontend_deploy .
  ar:adapt_frontend_report a ar:AdaptationMapping ;
    ar:sourceAssumption "Report screenshots and the live URL." ;
    ar:nanoclawModel "send_file for screenshots, send_message for the summary, through the host's delivery and destination checks." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "Delivery is asynchronous and limited to the session's projected destinations." ;
    ar:adaptedOperation ar:op_frontend_report .
}
