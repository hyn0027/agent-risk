@prefix ar: <urn:agent-risk:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ar:g_git_resources {
  ar:GitResourcesModule a ar:OntologyModule ;
    ar:ontologyModuleId "git-resources" ;
    ar:requiresOntologyModule "local-filesystem" .

  ar:LocalGitRepository a ar:WorldSurfaceKind, owl:Class ;
    ar:specializesKind ar:LocalDirectory ;
    rdfs:comment "Broad semantic kind. It is intentionally primitive: Git repositories include ordinary work trees, linked worktrees, bare repositories, and externally selected Git directories." .

  ar:GitMetadataEntryCandidate a ar:WorldSurfaceKind, owl:Class ;
    ar:specializesKind ar:FileSystemEntry ;
    owl:equivalentClass [
      a owl:Class ;
      owl:intersectionOf (
        ar:FileSystemEntry
        [ a owl:Restriction ; owl:onProperty ar:entryName ; owl:hasValue ".git" ]
      )
    ] ;
    rdfs:comment "A filesystem entry named .git. This is structural evidence, not proof that Git accepts it." .

  ar:ConventionalGitWorkingTreeCandidate a ar:WorldSurfaceKind, owl:Class ;
    ar:specializesKind ar:LocalDirectory ;
    owl:equivalentClass [
      a owl:Class ;
      owl:intersectionOf (
        ar:LocalDirectory
        [ a owl:Restriction ; owl:onProperty ar:containsEntry ; owl:someValuesFrom ar:GitMetadataEntryCandidate ]
      )
    ] ;
    rdfs:comment "Necessary-and-sufficient structural definition: a local directory containing an entry named .git. Named candidate because the marker may be malformed." .

  ar:ConventionalGitWorkingTree a ar:WorldSurfaceKind, owl:Class ;
    ar:specializesKind ar:LocalGitRepository, ar:ConventionalGitWorkingTreeCandidate ;
    owl:equivalentClass [
      a owl:Class ;
      owl:intersectionOf (
        ar:ConventionalGitWorkingTreeCandidate
        [ a owl:Restriction ; owl:onProperty ar:gitRepositoryValidated ; owl:hasValue true ]
      )
    ] ;
    rdfs:comment "A conventional .git-based working tree plus explicit evidence that Git validation succeeded." .

  ar:gitRepositoryValidated a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Observation that a Git-aware check accepted the directory; the ontology does not perform that external check." .
}
