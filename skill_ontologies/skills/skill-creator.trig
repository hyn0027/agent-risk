@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_skill_creator {
  ar:skill_skill_creator a ar:Skill ;
    ar:skillDirectory "skill-creator-1.0.0" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/agent-risk/top_skills/skill-creator-1.0.0/SKILL.md" ;
    ar:sourceSha256 "50ceafc65b49526d94b1263bc4a8ee381ce36249f2e370f3cdc414efa6a75c2f" ;
    ar:requiresOntologyModule "nanoclaw-runtime" ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_skill_creator_staging,
      ar:adapt_skill_creator_edit, ar:adapt_skill_creator_validation ;
    ar:sourceNote "NanoClaw adaptation: provider file tools stage and edit skill files in writable container-visible storage; the shared /app/skills mount remains read-only." ;
    ar:declaresOperation ar:op_creator_inspect, ar:op_creator_propose,
      ar:op_creator_repo_edit, ar:op_creator_validate .

  ar:NanoClawSkillStagingTool a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:NanoClawProviderFileTool ;
    ar:routesToKind ar:PendingSkillProposal .
  ar:SkillValidationScript a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:NanoClawContainerShellExecution .
  ar:SkillValidationScript ar:routesToKind ar:SkillFile .
  ar:SkillDirectory a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalDirectory .
  ar:SkillFile a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:SkillResource a ar:WorldSurfaceKind ;
    ar:mayBeStoredAsKind ar:LocalFile, ar:LocalDirectory ;
    rdfs:comment "Bundled resources may be files or directories; a single narrower file kind would overstate the source." .
  ar:PendingSkillProposal a ar:WorldSurfaceKind ; ar:mayBeStoredAsKind ar:LocalFile, ar:LocalDirectory .
  ar:RepositorySkillSource a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalDirectory .
  ar:ValidationResult a ar:WorldSurfaceKind .
  ar:SkillDirectory ar:containsKind ar:SkillFile, ar:SkillResource .
  ar:RepositorySkillSource ar:containsKind ar:SkillDirectory .
  ar:NanoClawSessionWorkspace ar:containsKind ar:PendingSkillProposal .

  ar:cond_workshop_available a ar:Requirement .
  ar:cond_repo_edit_authorized a ar:Requirement .
  ar:cond_validate_script_available a ar:Requirement .
  ar:cond_writable_skill_source_mounted a ar:Requirement .

  ar:op_creator_inspect a ar:Operation ; ar:invokedThroughKind ar:NanoClawProviderFileTool ;
    ar:targetsKind ar:SkillFile, ar:SkillResource ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:SkillFile, ar:SkillResource ] .

  ar:op_creator_propose a ar:Operation ; ar:invokedThroughKind ar:NanoClawSkillStagingTool ;
    ar:targetsKind ar:PendingSkillProposal ; ar:requires ar:cond_workshop_available ;
    ar:sourceNote "The described live-workspace branch creates/revises a pending proposal and keeps live files unchanged until apply." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:PendingSkillProposal ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:PendingSkillProposal ] .

  ar:op_creator_repo_edit a ar:Operation ; ar:invokedThroughKind ar:NanoClawProviderFileTool ;
    ar:targetsKind ar:RepositorySkillSource, ar:SkillFile, ar:SkillResource ;
    ar:requires ar:cond_repo_edit_authorized, ar:cond_writable_skill_source_mounted ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "The read-only shared skills mount cannot be edited. Apply requires a separately writable mounted repository or workspace copy." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:SkillFile, ar:SkillResource ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:SkillFile, ar:SkillResource ] .

  ar:op_creator_validate a ar:Operation ; ar:invokedThroughKind ar:SkillValidationScript ;
    ar:targetsKind ar:SkillDirectory, ar:ValidationResult ;
    ar:requires ar:cond_validate_script_available ;
    ar:sourceNote "The skill points to quick_validate.py, while the bundle lists quick_validate.py and tests; helper tests may have effects not audited here." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:SkillDirectory ],
      [ a ar:PotentialEffect ; ar:effectType ar:Validate ; ar:affectsKind ar:ValidationResult ] .

  ar:adapt_skill_creator_staging a ar:AdaptationMapping ;
    ar:sourceAssumption "Live workshop tool stages pending proposals." ;
    ar:nanoclawModel "Provider file tools create a staged proposal in writable session workspace." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "NanoClaw has no inspected built-in skill-workshop transaction or apply protocol." ;
    ar:adaptedOperation ar:op_creator_propose .

  ar:adapt_skill_creator_edit a ar:AdaptationMapping ;
    ar:sourceAssumption "Repository skill source can be edited." ;
    ar:nanoclawModel "Provider file tools edit only a separately writable mounted repository or workspace copy." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "/app/skills is read-only, so the shared installed skill tree cannot be edited in place." ;
    ar:adaptedOperation ar:op_creator_repo_edit .

  ar:adapt_skill_creator_validation a ar:AdaptationMapping ;
    ar:sourceAssumption "Validation script runs locally." ;
    ar:nanoclawModel "Container shell runs the validation script against the writable skill directory." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "The script and its dependencies must be visible inside the container." ;
    ar:adaptedOperation ar:op_creator_validate .
}
