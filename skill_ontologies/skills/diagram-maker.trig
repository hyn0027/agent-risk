@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_diagram_maker {
  ar:skill_diagram_maker a ar:Skill ;
    ar:skillDirectory "diagram-maker-1.0.0" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/agent-risk/top_skills/diagram-maker-1.0.0/SKILL.md" ;
    ar:sourceSha256 "b8a3355cf2b7ca1c18b672d3fb23fba331db0da75308b403721a9918094b7bcb" ;
    ar:requiresOntologyModule "nanoclaw-runtime" ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_diagram_file_tools ;
    ar:sourceNote "NanoClaw adaptation: provider file tools read and write artifacts within the container-visible filesystem." ;
    ar:declaresOperation ar:op_diagram_read_patterns,
      ar:op_diagram_write_artifact, ar:op_diagram_verify .

  ar:LocalArtifactWriter a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:NanoClawProviderFileTool ;
    rdfs:comment "Provider file-write operation constrained to the NanoClaw container-visible filesystem." .
  ar:LocalArtifactReader a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:NanoClawProviderFileTool ;
    rdfs:comment "Provider file-read/search operation constrained to the NanoClaw container-visible filesystem." .
  ar:DiagramTemplate a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:DiagramArtifact a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:DiagramHTML a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:DiagramSVG a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:ExcalidrawJSON a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:LocalFileSystem ar:containsKind ar:DiagramTemplate, ar:DiagramArtifact .
  ar:NanoClawContainerFileSystem ar:containsKind ar:DiagramTemplate, ar:DiagramArtifact .
  ar:DiagramArtifact ar:containsKind ar:DiagramHTML, ar:DiagramSVG, ar:ExcalidrawJSON .

  ar:cond_output_path_writable a ar:Requirement .
  ar:cond_format_chosen a ar:Requirement .
  ar:cond_parser_available a ar:Requirement .

  ar:op_diagram_read_patterns a ar:Operation ; ar:invokedThroughKind ar:LocalArtifactReader ;
    ar:targetsKind ar:DiagramTemplate ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "The SVG and Excalidraw reference files provide output templates/patterns." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:DiagramTemplate ] .

  ar:op_diagram_write_artifact a ar:Operation ; ar:invokedThroughKind ar:LocalArtifactWriter ;
    ar:targetsKind ar:DiagramArtifact ;
    ar:requires ar:cond_output_path_writable, ar:cond_format_chosen ;
    ar:sourceNote "Writes one standalone SVG/HTML or Excalidraw artifact at the requested or default local path; no remote assets are specified." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:DiagramArtifact ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:DiagramArtifact ] .

  ar:op_diagram_verify a ar:Operation ; ar:invokedThroughKind ar:LocalArtifactReader ;
    ar:targetsKind ar:DiagramArtifact ; ar:requires ar:cond_parser_available ;
    ar:sourceNote "Verification is conditional on a feasible opener/parser; it does not imply publishing the diagram." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:DiagramArtifact ],
      [ a ar:PotentialEffect ; ar:effectType ar:Validate ; ar:affectsKind ar:DiagramArtifact ] .

  ar:adapt_diagram_file_tools a ar:AdaptationMapping ;
    ar:sourceAssumption "Unspecified local artifact reader/writer." ;
    ar:nanoclawModel "NanoClawProviderFileTool subtypes acting on the container-visible filesystem." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "The provider must expose file tools and the output path must be writable. Host files are affected only through explicit writable mounts." ;
    ar:adaptedOperation ar:op_diagram_read_patterns,
      ar:op_diagram_write_artifact, ar:op_diagram_verify .
}
