@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_gh_issues {
  ar:skill_gh_issues a ar:Skill ;
    ar:skillDirectory "gh-issues" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/agent-risk/top_skills/gh-issues/SKILL.md" ;
    ar:sourceSha256 "f2a787203a90572835e7b7bfe939a422c7d7e1828662d60ad2e4a0db8c9f5577" ;
    ar:requiresOntologyModule "git-resources", "nanoclaw-core", "nanoclaw-runtime",
      "nanoclaw-network", "nanoclaw-messaging" ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_gh_shell_environment,
      ar:adapt_gh_token_resolution, ar:adapt_gh_tracking_state,
      ar:adapt_gh_delegation, ar:adapt_gh_telegram_notification ;
    ar:sourceNote "NanoClaw adaptation: curl/git run in the session container, delegated work uses create_agent plus named-destination messaging, and Telegram notification uses send_message." ;
    ar:declaresOperation ar:op_gh_fetch, ar:op_gh_token_resolution,
      ar:op_gh_write_tracking, ar:op_gh_local_git, ar:op_gh_spawn_fix,
      ar:op_gh_push, ar:op_gh_create_pr, ar:op_gh_fetch_review,
      ar:op_gh_spawn_review_fix, ar:op_gh_reply_review, ar:op_gh_telegram_notify .

  ar:GitHubREST a ar:InvocationSurfaceKind ; ar:routesToKind ar:GitHubRepository .
  ar:CurlCLI a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:NanoClawContainerShellExecution .
  ar:GitCLI a ar:InvocationSurfaceKind, ar:ToolEndpointKind ;
    ar:specializesInvocationKind ar:NanoClawContainerShellExecution .
  ar:CurlCLI ar:routesToKind ar:GitHubREST, ar:NanoClawProxyAwareHTTPRequest,
    ar:NanoClawDirectNetworkRequest .
  ar:GitCLI ar:routesToKind ar:LocalGitRepository, ar:GitHubRepository .
  ar:TelegramAdapterDelivery a ar:InvocationSurfaceKind ;
    ar:specializesInvocationKind ar:NanoClawChannelAdapterDelivery ;
    ar:routesToKind ar:TelegramDestination .
  ar:NanoClawHostDeliveryInvocation ar:routesToKind ar:TelegramAdapterDelivery .
  ar:GitHubRepository a ar:WorldSurfaceKind .
  ar:GitHubIssue a ar:WorldSurfaceKind .
  ar:GitHubPullRequest a ar:WorldSurfaceKind .
  ar:GitHubBranch a ar:WorldSurfaceKind .
  ar:GitHubReview a ar:WorldSurfaceKind .
  ar:GitHubComment a ar:WorldSurfaceKind .
  ar:LocalBranch a ar:WorldSurfaceKind .
  ar:LocalGitConfiguration a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:GlobalGitConfiguration a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:TrackingFile a ar:WorldSurfaceKind ; ar:specializesKind ar:LocalFile .
  ar:GHAccessToken a ar:WorldSurfaceKind .
  ar:ProcessOutput a ar:WorldSurfaceKind ; ar:specializesKind ar:ShellProcessOutput .
  ar:TelegramDestination a ar:WorldSurfaceKind .
  ar:TelegramMessage a ar:WorldSurfaceKind ; ar:specializesKind ar:MessagingMessage .
  ar:GitHubRepository ar:containsKind ar:GitHubIssue, ar:GitHubPullRequest,
    ar:GitHubBranch, ar:GitHubReview, ar:GitHubComment .
  ar:LocalGitRepository ar:containsKind ar:LocalBranch, ar:LocalGitConfiguration .
  ar:NanoClawAgentGroupWorkspace ar:containsKind ar:TrackingFile .

  ar:cond_repo_resolved a ar:Requirement .
  ar:cond_gh_token a ar:Requirement .
  ar:cond_issue_confirmed a ar:Requirement .
  ar:cond_trusted_checkout a ar:Requirement .
  ar:cond_push_permission a ar:Requirement .
  ar:cond_pr_comment_permission a ar:Requirement .
  ar:cond_telegram_route a ar:Requirement .
  ar:cond_repo_mount_visible a ar:Requirement .
  ar:cond_nanoclaw_child_destination a ar:Requirement .

  ar:op_gh_fetch a ar:Operation ; ar:invokedThroughKind ar:CurlCLI, ar:GitHubREST ;
    ar:targetsKind ar:GitHubRepository, ar:GitHubIssue ;
    ar:requires ar:cond_repo_resolved, ar:cond_gh_token ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:GitHubIssue, ar:GitHubRepository ] .

  ar:op_gh_token_resolution a ar:Operation ; ar:invokedThroughKind ar:NanoClawContainerShellExecution ;
    ar:targetsKind ar:GHAccessToken, ar:ProcessEnvironment, ar:OneCLICredentialStub ;
    ar:sourceNote "A NanoClaw deployment may inject an environment credential or provide a OneCLI stub. The original OpenClaw config-file fallback is removed. Printing token material remains a possible output/log exposure." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:GHAccessToken, ar:ProcessEnvironment, ar:OneCLICredentialStub ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:ProcessOutput ] .

  ar:op_gh_write_tracking a ar:Operation ; ar:invokedThroughKind ar:NanoClawContainerShellExecution ;
    ar:targetsKind ar:TrackingFile, ar:NanoClawAgentGroupWorkspace ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Claims and cursor files are translated to the persistent per-agent-group workspace; the original /data/.clawdbot path does not exist by contract in NanoClaw." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:TrackingFile ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:TrackingFile ] .

  ar:op_gh_local_git a ar:Operation ; ar:invokedThroughKind ar:NanoClawContainerShellExecution, ar:GitCLI ;
    ar:targetsKind ar:LocalGitRepository, ar:LocalBranch ;
    ar:requires ar:cond_repo_resolved, ar:cond_trusted_checkout, ar:cond_repo_mount_visible ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:LocalBranch ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:LocalGitRepository ] .

  ar:op_gh_spawn_fix a ar:Operation ;
    ar:invokedThroughKind ar:NanoClawCreateAgentTool, ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:GitHubIssue, ar:LocalGitRepository ;
    ar:requires ar:cond_issue_confirmed, ar:cond_nanoclaw_child_destination ;
    ar:sourceNote "NanoClaw create_agent creates a long-lived companion, not an ephemeral sub-agent. Work is assigned through its projected destination; code and remote effects remain open-ended." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Delegate ; ar:affectsKind ar:LocalGitRepository ] .

  ar:op_gh_push a ar:Operation ; ar:invokedThroughKind ar:NanoClawContainerShellExecution, ar:GitCLI ;
    ar:targetsKind ar:GitHubBranch, ar:LocalGitConfiguration, ar:GlobalGitConfiguration ;
    ar:requires ar:cond_gh_token, ar:cond_push_permission ;
    ar:sourceNote "The described push flow changes the global credential helper and embeds the token in a Git remote URL. No force-push is instructed." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:GitHubBranch ],
      [ a ar:PotentialEffect ; ar:effectType ar:Configure ; ar:affectsKind ar:LocalGitConfiguration, ar:GlobalGitConfiguration ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:LocalGitConfiguration ] .

  ar:op_gh_create_pr a ar:Operation ; ar:invokedThroughKind ar:CurlCLI, ar:GitHubREST ;
    ar:targetsKind ar:GitHubRepository ; ar:requires ar:cond_gh_token, ar:cond_push_permission ;
    ar:sourceNote "Creates a PR record; does not assert merge, release, or deployment." ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:GitHubPullRequest ] .

  ar:op_gh_fetch_review a ar:Operation ; ar:invokedThroughKind ar:CurlCLI, ar:GitHubREST ;
    ar:targetsKind ar:GitHubPullRequest, ar:GitHubReview, ar:GitHubComment ;
    ar:requires ar:cond_gh_token ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:GitHubReview, ar:GitHubComment, ar:GitHubPullRequest ] .

  ar:op_gh_spawn_review_fix a ar:Operation ;
    ar:invokedThroughKind ar:NanoClawCreateAgentTool, ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:GitHubPullRequest, ar:LocalGitRepository ;
    ar:requires ar:cond_nanoclaw_child_destination ; ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Delegate ; ar:affectsKind ar:LocalGitRepository, ar:GitHubPullRequest ] .

  ar:op_gh_reply_review a ar:Operation ; ar:invokedThroughKind ar:CurlCLI, ar:GitHubREST ;
    ar:targetsKind ar:GitHubComment ; ar:requires ar:cond_gh_token, ar:cond_pr_comment_permission ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:GitHubComment ] .

  ar:op_gh_telegram_notify a ar:Operation ; ar:invokedThroughKind ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:TelegramDestination ; ar:requires ar:cond_telegram_route ;
    ar:sourceStatus ar:SkillText ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "The Telegram route is a NanoClaw named destination projected into the session; send_message does not accept the source skill's raw --notify-channel convention." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:TelegramMessage ],
      [ a ar:PotentialEffect ; ar:effectType ar:Notify ; ar:affectsKind ar:TelegramDestination ] .

  ar:adapt_gh_shell_environment a ar:AdaptationMapping ;
    ar:sourceAssumption "curl and git run in the host/OpenClaw environment." ;
    ar:nanoclawModel "They run through NanoClawContainerShellExecution; HTTP may use OneCLI or direct egress depending on effective policy." ;
    ar:adaptationDisposition ar:ConditionalAdaptation ;
    ar:semanticDifference "Execution depends on packages, network, repository mount, and credentials." ;
    ar:adaptedOperation ar:op_gh_fetch, ar:op_gh_local_git, ar:op_gh_push,
      ar:op_gh_create_pr, ar:op_gh_fetch_review, ar:op_gh_reply_review .

  ar:adapt_gh_token_resolution a ar:AdaptationMapping ;
    ar:sourceAssumption "Token falls back to OpenClaw JSON configuration." ;
    ar:nanoclawModel "Environment credential or OneCLI credential stub." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "The OpenClaw config-file fallback and its paths are removed." ;
    ar:adaptedOperation ar:op_gh_token_resolution .

  ar:adapt_gh_tracking_state a ar:AdaptationMapping ;
    ar:sourceAssumption "Claims and cursors live under /data/.clawdbot." ;
    ar:nanoclawModel "Files live in persistent NanoClawAgentGroupWorkspace." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "The persistence path and scope differ." ;
    ar:adaptedOperation ar:op_gh_write_tracking .

  ar:adapt_gh_delegation a ar:AdaptationMapping ;
    ar:sourceAssumption "Spawn ephemeral parallel sub-agents." ;
    ar:nanoclawModel "NanoClawCreateAgentTool, followed by send_message to the created named destination." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "NanoClaw creates long-lived companion agents and may require approval. Lifecycle, concurrency, and cleanup differ." ;
    ar:adaptedOperation ar:op_gh_spawn_fix, ar:op_gh_spawn_review_fix .

  ar:adapt_gh_telegram_notification a ar:AdaptationMapping ;
    ar:sourceAssumption "Send final Telegram result to a raw channel id." ;
    ar:nanoclawModel "NanoClawSendMessageTool to a projected Telegram destination." ;
    ar:adaptationDisposition ar:NativeAdaptation ;
    ar:semanticDifference "The messaging path is native but uses a different addressing and authorization model." ;
    ar:adaptedOperation ar:op_gh_telegram_notify .
}
