@prefix ar: <urn:agent-risk:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ar:g_taskflow_inbox_triage {
  ar:skill_taskflow_inbox_triage a ar:Skill ;
    ar:skillDirectory "taskflow-inbox-triage" ;
    ar:sourcePath "/Users/yhong3/Documents/Research/agent-risk/top_skills/taskflow-inbox-triage/SKILL.md" ;
    ar:sourceSha256 "0fb413b107f9b0f5625136869cd5a979ecd65e1a756216705bee2ae0b8d1112c" ;
    ar:requiresOntologyModule "nanoclaw-core", "nanoclaw-messaging", "nanoclaw-control" ;
    ar:governedByAdaptationPolicy ar:NanoClawSkillAdaptationPolicy ;
    ar:hasAdaptationMapping ar:adapt_taskflow_creation,
      ar:adapt_taskflow_children, ar:adapt_taskflow_wait,
      ar:adapt_taskflow_resume, ar:adapt_taskflow_notifications ;
    ar:sourceNote "NanoClaw approximation: scheduled tasks and task logs provide durable wakeups/state; companion agents plus destinations replace ephemeral TaskFlow children. NanoClaw does not implement TaskFlow's exact suspend/wait/resume primitive." ;
    ar:declaresOperation ar:op_taskflow_create, ar:op_taskflow_classify,
      ar:op_taskflow_wait, ar:op_taskflow_resume_finish,
      ar:op_taskflow_slack_post, ar:op_taskflow_personal_notify,
      ar:op_taskflow_eod_summary .

  ar:SlackAdapterDelivery a ar:InvocationSurfaceKind ;
    ar:specializesInvocationKind ar:NanoClawChannelAdapterDelivery ;
    ar:routesToKind ar:SlackWorkspace .
  ar:NanoClawHostDeliveryInvocation ar:routesToKind ar:SlackAdapterDelivery .

  ar:InboxBatch a ar:WorldSurfaceKind .
  ar:InboxItem a ar:WorldSurfaceKind .
  ar:ManagedFlow a ar:WorldSurfaceKind ; ar:specializesKind ar:NanoClawScheduledTask .
  ar:ManagedFlowState a ar:WorldSurfaceKind ; ar:mayBeStoredAsKind ar:NanoClawTaskRunLog .
  ar:ChildAgentGroup a ar:WorldSurfaceKind ; ar:specializesKind ar:NanoClawAgentGroup .
  ar:SlackWorkspace a ar:WorldSurfaceKind ; ar:specializesKind ar:MessagingPlatform .
  ar:SlackAPIEndpoint a ar:WorldSurfaceKind, ar:PublicInternetEndpointKind ;
    ar:specializesKind ar:PublicInternetEndpoint ;
    rdfs:comment "Public Slack delivery endpoint; exact route and URL depend on the registered adapter." .
  ar:SlackThread a ar:WorldSurfaceKind ; ar:specializesKind ar:MessagingThread .
  ar:SlackMessage a ar:WorldSurfaceKind ; ar:specializesKind ar:MessagingMessage .
  ar:OwnerNotificationDestination a ar:WorldSurfaceKind ; ar:specializesKind ar:NanoClawDestination .
  ar:OwnerNotification a ar:WorldSurfaceKind ; ar:specializesKind ar:MessagingMessage .
  ar:EndOfDaySummary a ar:WorldSurfaceKind .
  ar:InboxBatch ar:containsKind ar:InboxItem .
  ar:ManagedFlow ar:containsKind ar:ManagedFlowState .
  ar:SlackWorkspace ar:containsKind ar:SlackThread, ar:SlackMessage .

  ar:cond_tasks_cli_scope a ar:Requirement .
  ar:cond_create_agent_authorized a ar:Requirement .
  ar:cond_child_destination_projected a ar:Requirement .
  ar:cond_slack_destination_projected a ar:Requirement .
  ar:cond_owner_destination_projected a ar:Requirement .
  ar:cond_outside_reply_arrives a ar:Requirement .

  ar:op_taskflow_create a ar:Operation ; ar:invokedThroughKind ar:NanoClawContainerTasksCLI ;
    ar:targetsKind ar:ManagedFlow, ar:NanoClawTaskRunLog ; ar:requires ar:cond_tasks_cli_scope ;
    ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Creates a NanoClaw scheduled task series and optionally appends progress to its run log; this is not a TaskFlow instance." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:ManagedFlow, ar:ManagedFlowState, ar:NanoClawTaskRunLog ] .

  ar:op_taskflow_classify a ar:Operation ;
    ar:invokedThroughKind ar:NanoClawCreateAgentTool, ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:InboxBatch, ar:ChildAgentGroup, ar:ManagedFlowState ;
    ar:requires ar:cond_create_agent_authorized, ar:cond_child_destination_projected ;
    ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Classification can be assigned to long-lived companion agents. NanoClaw create_agent is not an ephemeral child-task primitive and may require approval." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:InboxItem ],
      [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:ChildAgentGroup ],
      [ a ar:PotentialEffect ; ar:effectType ar:Delegate ; ar:affectsKind ar:ChildAgentGroup ],
      [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:ManagedFlowState ] .

  ar:op_taskflow_wait a ar:Operation ; ar:invokedThroughKind ar:NanoClawAgentRunnerMailboxRead ;
    ar:targetsKind ar:NanoClawInboundMailbox, ar:ManagedFlowState ;
    ar:requires ar:cond_outside_reply_arrives ; ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "There is no TaskFlow waitJson equivalent. A later inbound platform or agent message starts/resumes a NanoClaw turn, which can consult persistent task/log state." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Read ; ar:affectsKind ar:NanoClawInboundMessage, ar:ManagedFlowState ] .

  ar:op_taskflow_resume_finish a ar:Operation ; ar:invokedThroughKind ar:NanoClawContainerTasksCLI ;
    ar:targetsKind ar:ManagedFlow, ar:ManagedFlowState, ar:NanoClawTaskRunLog ;
    ar:requires ar:cond_tasks_cli_scope ; ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Updates, pauses, deletes, or logs a NanoClaw task series after a later turn; it is not an atomic continuation of a suspended execution stack." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Update ; ar:affectsKind ar:ManagedFlow, ar:ManagedFlowState, ar:NanoClawTaskRunLog ],
      [ a ar:PotentialEffect ; ar:effectType ar:Delete ; ar:affectsKind ar:ManagedFlow ] .

  ar:op_taskflow_slack_post a ar:Operation ; ar:invokedThroughKind ar:NanoClawSendMessageTool ;
    ar:mayInitiateInternetCall ar:call_taskflow_slack_delivery ;
    ar:targetsKind ar:SlackThread ; ar:requires ar:cond_slack_destination_projected ;
    ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "Posts to a projected Slack destination. Adapter registration and live destination authority are deployment facts, not ontology guarantees." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:SlackMessage ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:SlackThread ] .

  ar:call_taskflow_slack_delivery a ar:PotentialInternetCall ;
    ar:callInitiatorKind ar:NanoClawHostProcess ; ar:callViaKind ar:SlackAdapterDelivery ;
    ar:callEndpointKind ar:SlackAPIEndpoint ; ar:callStage ar:HostAdapterEgress ;
    ar:sourceStatus ar:InferredForNanoClaw ; ar:sourceNote "Slack posting is an example-only skill action adapted to a projected NanoClaw destination. The built-in tool and mailbox hops are local; only adapter delivery is Internet egress." .

  ar:op_taskflow_personal_notify a ar:Operation ; ar:invokedThroughKind ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:OwnerNotificationDestination ; ar:requires ar:cond_owner_destination_projected ;
    ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:OwnerNotification ],
      [ a ar:PotentialEffect ; ar:effectType ar:Notify ; ar:affectsKind ar:OwnerNotificationDestination ] .

  ar:op_taskflow_eod_summary a ar:Operation ;
    ar:invokedThroughKind ar:NanoClawContainerTasksCLI, ar:NanoClawSendMessageTool ;
    ar:targetsKind ar:EndOfDaySummary, ar:ManagedFlow, ar:OwnerNotificationDestination ;
    ar:requires ar:cond_tasks_cli_scope, ar:cond_owner_destination_projected ;
    ar:sourceStatus ar:ExampleOnly ; ar:adaptationStatus ar:InferredForNanoClaw ;
    ar:sourceNote "A recurring or one-shot NanoClaw scheduled task composes the summary and send_message delivers it to a named destination." ;
    ar:hasPotentialEffect [ a ar:PotentialEffect ; ar:effectType ar:Create ; ar:affectsKind ar:EndOfDaySummary, ar:ManagedFlow ],
      [ a ar:PotentialEffect ; ar:effectType ar:Transmit ; ar:affectsKind ar:OwnerNotificationDestination ] .

  ar:adapt_taskflow_creation a ar:AdaptationMapping ;
    ar:sourceAssumption "Create a TaskFlow and durable child tasks." ;
    ar:nanoclawModel "Create a NanoClaw scheduled task series and use its task run log for durable progress." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "A scheduled task is a timed prompt/session mechanism, not a general workflow DAG." ;
    ar:adaptedOperation ar:op_taskflow_create .

  ar:adapt_taskflow_children a ar:AdaptationMapping ;
    ar:sourceAssumption "Spawn short-lived classification children." ;
    ar:nanoclawModel "Create long-lived companion agents and delegate by named-destination messages." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "Lifecycle and authority differ, and creation may require approval." ;
    ar:adaptedOperation ar:op_taskflow_classify .

  ar:adapt_taskflow_wait a ar:AdaptationMapping ;
    ar:sourceAssumption "waitJson suspends until a matching Slack reply." ;
    ar:nanoclawModel "A later inbound message causes a new or resumed NanoClaw turn, which consults persisted task/log state." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "This is a major approximation: there is no atomic wait predicate or suspended execution stack. Correlation logic must be implemented in prompts or state." ;
    ar:adaptedOperation ar:op_taskflow_wait .

  ar:adapt_taskflow_resume a ar:AdaptationMapping ;
    ar:sourceAssumption "Resume and finish the same flow." ;
    ar:nanoclawModel "A later turn updates, pauses, or deletes the scheduled task and appends its run log." ;
    ar:adaptationDisposition ar:ApproximateAdaptation ;
    ar:semanticDifference "This is not transactional continuation." ;
    ar:adaptedOperation ar:op_taskflow_resume_finish .

  ar:adapt_taskflow_notifications a ar:AdaptationMapping ;
    ar:sourceAssumption "Slack and personal notifications use abstract routes." ;
    ar:nanoclawModel "NanoClawSendMessageTool uses projected named destinations through the outbound mailbox." ;
    ar:adaptationDisposition ar:NativeAdaptation, ar:ConditionalAdaptation ;
    ar:semanticDifference "The path is native but depends on installed adapters, destination ACLs, and live wiring." ;
    ar:adaptedOperation ar:op_taskflow_slack_post,
      ar:op_taskflow_personal_notify, ar:op_taskflow_eod_summary .
}
